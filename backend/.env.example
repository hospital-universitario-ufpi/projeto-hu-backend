# Hospital Management System - Environment Variables Template
# Copy this file to .env and customize the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database connection URL
DB_URL=jdbc:mysql://localhost:3306/db?createDatabaseIfNotExists=true

# Database credentials (CHANGE THESE IN PRODUCTION!)
DB_USERNAME=admin
DB_PASSWORD=admin

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT Secret Key - MUST BE CHANGED IN PRODUCTION!
# Generate a strong random secret (minimum 256 bits)
# You can use: openssl rand -base64 32
JWT_SECRET=ChaveJWTUltraSecretaHuBackendSegura2025TemporariaParaDesenvolvimento

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port
SERVER_PORT=8095

# Cookie security (set to true in production with HTTPS)
COOKIE_SECURE=false

# =============================================================================
# JPA/HIBERNATE CONFIGURATION
# =============================================================================
# Show SQL queries in logs (set to false in production)
JPA_SHOW_SQL=true

# Database schema handling (use 'validate' in production)
JPA_DDL_AUTO=update

# =============================================================================
# PRODUCTION SECURITY SETTINGS
# =============================================================================
# Uncomment and modify these for production deployment:

# Strong JWT secret (replace with randomly generated value)
# JWT_SECRET=your-super-strong-random-secret-minimum-256-bits

# Production database settings
# DB_URL=jdbc:mysql://your-production-db-host:3306/your-database-name
# DB_USERNAME=your-production-db-user
# DB_PASSWORD=your-production-db-password

# Production server settings
# SERVER_PORT=8080
# COOKIE_SECURE=true
# JPA_SHOW_SQL=false
# JPA_DDL_AUTO=validate

# =============================================================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT
# =============================================================================
# 1. Generate a strong JWT secret:
#    openssl rand -base64 32
#
# 2. Set up a dedicated database user with minimal required permissions
#
# 3. Use HTTPS and set COOKIE_SECURE=true
#
# 4. Set JPA_DDL_AUTO=validate to prevent accidental schema changes
#
# 5. Set JPA_SHOW_SQL=false to avoid logging sensitive data
#
# 6. Consider using a secret management service for sensitive values
#
# 7. Regularly rotate JWT secrets and database passwords
#
# =============================================================================
# DOCKER MYSQL COMMAND
# =============================================================================
# To start a MySQL container for development:
# docker run -d --name mysql_hu \
#   -e MYSQL_ROOT_PASSWORD=admin \
#   -e MYSQL_USER=admin \
#   -e MYSQL_PASSWORD=admin \
#   -e MYSQL_DATABASE=db \
#   -p 3306:3306 \
#   mysql:8.0